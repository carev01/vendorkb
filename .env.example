# Copy to .env (never committed) and fill in. Every name maps to a VendorkbSettings field.
VENDORKB_DSN=postgresql://postgres:<password>@127.0.0.1:55442/vendorkb
VENDORKB_DB_PASSWORD=          # read by docker-compose.yml only

# Embeddings: voyage-4 by default (the code defaults); only the key is needed
EMBED_API_KEY=

# Reranker (Voyage /v1/rerank)
RERANK_BASE_URL=https://api.voyageai.com/v1
RERANK_MODEL=rerank-3
RERANK_API_KEY=

# Answer writer (OpenAI-compatible chat completions)
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=z-ai/glm-5.3-flash
JUDGE_API_KEY=
ANSWER_REASONING_EFFORT=low

# DocExtractor (read-only key)
DOCEXT_BASE_URL=https://docextractor.k3s.home.lan
DOCEXT_READ_KEY=
DOCEXT_VERIFY_TLS=true
