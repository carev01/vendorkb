# The Vast.ai serverless extractor (README.md). Sourced by deploy.sh; SEARCH_PARAMS is also
# the Helm value claimsRefresh.extract.vast.searchParams (keep the two the same).
ENDPOINT=vendorkb-extractor
TEMPLATE_NAME=vendorkb-extractor-serverless
IMAGE=vastai/vllm
IMAGE_TAG=v0.32.0-cuda-13.0          # vLLM 0.32.0, as validated; CUDA 13 needs cuda_max_good>=13.0
MODEL_REPO=carev01/vendorkb-qwen3.5-9b-r2   # private: the r2 adapter merged into Qwen3.5-9B
DISK_GB=60
# GPUs known to serve the bf16 9B with these flags (48 GB class or A100 40 GB), on CUDA 13
# hosts; the cheapest matches without the name list were Turing (no bf16), ARM (GB10) and
# mining cards.
SEARCH_PARAMS='gpu_name in [A100_PCIE,A100_SXM4,RTX_A6000,L40S,L40,A40,RTX_6000Ada] num_gpus=1 compute_cap>=800 cuda_max_good>=13.0 direct_port_count>=2 inet_down>=500 reliability>0.98 verified=true dph<=0.9 disk_space>=60'
# Scale to zero, never more than one worker, no standby workers (a stopped one is rented away).
MIN_LOAD=0
COLD_WORKERS=0
MAX_WORKERS=1
INACTIVITY_TIMEOUT=300
MAX_QUEUE_TIME=900
TARGET_QUEUE_TIME=300
